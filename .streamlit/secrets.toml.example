# Copy these values into Streamlit Community Cloud > App settings > Secrets.
# Never commit a real secrets.toml file or real API keys.

GEMINI_API_KEY = ""
OPENAI_API_KEY = ""

# Recommended for persistent cloud data. Without this setting, Streamlit
# Community Cloud uses the local SQLite file system, which is not persistent.
DATABASE_URL = "postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Optional individual PostgreSQL settings when DATABASE_URL is not used.
# PGHOST = ""
# PGDATABASE = "postgres"
# PGUSER = "postgres"
# PGPASSWORD = ""
# PGPORT = "5432"
